# AquaVerse AI Ingress Proxy - Caddyfile
# TLS Termination & Fast Reverse Proxy for FastAPI Async Uvicorn Stack

{
  admin off
  auto_https off
}

http://localhost:80, http://localhost:8080 {
  # TLS Termination Point
  tls internal

  # Compression
  encode gzip zstd

  # API Endpoints Routing (/v1/*) -> FastAPI Async Backend
  handle /v1/* {
    reverse_proxy fastapi-backend:8000 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  # Object Storage Direct Gateway (/uploads/*) -> MinIO / R2
  handle /uploads/* {
    reverse_proxy minio:9000 {
      header_up Host {host}
    }
  }

  # Client Static Frontend Assets -> Vite SPA Build
  handle {
    root * /srv/dist
    try_files {path} /index.html
    file_server
  }
}
