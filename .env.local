# =============================================================================
# AquaVerse AI — Backend Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                     # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=c3ab8ff13720e8ad9047dd39466b3c89   # used for signing internal tokens
INTERNAL_API_TOKEN=b78c9d0f1e2a3b4c5d6e7f8a9b0c1d2e   # guards POST /v1/reason (internal-only)

# ---------------------------------------------------------------------------
# Database — PostgreSQL 16 + TimescaleDB + PostGIS (single DB)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aquaverse
POSTGRES_USER=aquaverse
POSTGRES_PASSWORD=aquaverse
DATABASE_URL=postgresql+asyncpg://aquaverse:aquaverse@localhost:5432/aquaverse
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Redis (cache + ARQ broker + rate-limiting)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600            # translation cache default TTL

# ---------------------------------------------------------------------------
# Auth — Keycloak (staff RBAC) + OTP (farmers)
# ---------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=aquaverse
KEYCLOAK_CLIENT_ID=aquaverse-backend
KEYCLOAK_CLIENT_SECRET=f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=./certs/jwt_public.pem   # RS256 public key for JWT verify
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
# SMS / phone OTP gateway
SMS_PROVIDER=mock                        # mock | fast2sms | twilio
SMS_API_KEY=mock_sms_api_key_12345

# ---------------------------------------------------------------------------
# Object Storage — MinIO (self-hosted) or Cloudflare R2
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_secret
S3_BUCKET_NAME=aquaverse-media
S3_PRESIGN_EXPIRY_SECONDS=900

# ---------------------------------------------------------------------------
# LLM / Model Serving
# ---------------------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_LORA_M1=adapters/m1_chemistry
VLLM_LORA_M2=adapters/m2_health
VLLM_LORA_M3=adapters/m3_production
OLLAMA_BASE_URL=http://localhost:11434   # CPU fallback
OLLAMA_MODEL=qwen3:8b-q4_K_M

# ---------------------------------------------------------------------------
# Numeric Models
# ---------------------------------------------------------------------------
MODEL_ARTIFACTS_DIR=./ml/artifacts
DEFAULT_MODEL_VERSION=latest

# ---------------------------------------------------------------------------
# MLflow
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=aquaverse-production

# ---------------------------------------------------------------------------
# Local GPU Training — RTX 5070 (12 GB VRAM), Intel Core Ultra 9 285K, 32 GB RAM
# Shifted from Kaggle 2×T4 to local workstation execution.
# ---------------------------------------------------------------------------
TRAIN_DEVICE=cuda                        # cuda | cpu
TRAIN_GPU_ID=0                           # GPU index (nvidia-smi)
TRAIN_CUDA_VERSION=13.2                  # driver-reported CUDA version
TRAIN_GPU_NAME=NVIDIA GeForce RTX 5070
TRAIN_GPU_VRAM_GB=12

# QLoRA / Unsloth settings (Phase 2 — M2 adapter fine-tuning)
TRAIN_QLORA_LOAD_IN_4BIT=true
TRAIN_QLORA_R=16                         # LoRA rank
TRAIN_QLORA_ALPHA=32                     # LoRA alpha
TRAIN_QLORA_DROPOUT=0.05
TRAIN_MAX_SEQ_LEN=2048
TRAIN_BATCH_SIZE=4                       # per-GPU batch size (adjust if OOM)
TRAIN_GRAD_ACCUM_STEPS=4                 # effective batch = 16
TRAIN_LEARNING_RATE=2e-4
TRAIN_NUM_EPOCHS=3
TRAIN_WARMUP_RATIO=0.03
TRAIN_LR_SCHEDULER=cosine
TRAIN_OUTPUT_DIR=./ml/artifacts/m2_health
TRAIN_LOGGING_DIR=./ml/artifacts/m2_health/logs

# MLflow hardware tracking
MLFLOW_TAGS_HARDWARE=RTX5070-12GB
MLFLOW_TAGS_CUDA=13.2
MLFLOW_TAGS_UNSLOTH=local
MLFLOW_TAGS_COMPUTE=local-workstation

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=                              # leave blank to disable
PROMETHEUS_METRICS_PATH=/metrics
LOG_LEVEL=INFO
LOG_FORMAT=json                          # json | console

# ---------------------------------------------------------------------------
# i18n / Translation
# ---------------------------------------------------------------------------
BHASHINI_API_KEY=CHANGE_ME
BHASHINI_USER_ID=CHANGE_ME
BHASHINI_PIPELINE_ID=CHANGE_ME
AI4BHARAT_API_URL=https://api.ai4bharat.org/inference

# ---------------------------------------------------------------------------
# FCM (mobile push notifications)
# ---------------------------------------------------------------------------
FCM_SERVICE_ACCOUNT_PATH=./certs/fcm_service_account.json

# ---------------------------------------------------------------------------
# Geo
# ---------------------------------------------------------------------------
DEFAULT_SRID=4326

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_OTP_PER_MINUTE=5
RATE_LIMIT_ASK_PER_MINUTE=30

# ---------------------------------------------------------------------------
# Caddy / TLS (production only)
# ---------------------------------------------------------------------------
DOMAIN=aquaverse.example.com
